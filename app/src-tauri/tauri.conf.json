{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Setup Assistant",
  "version": "0.1.0",
  "identifier": "dev.simracing.setupassistant",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Setup Assistant",
        "width": 1280,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 660
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
